[Unit]
Description=SVT Play download and subtitle worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/svtplay
Environment=HOME=/var/lib/svtplay
UMask=0027
ExecStart=/usr/bin/php /var/www/html/svtplay/worker.php
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/svtplay

[Install]
WantedBy=multi-user.target
